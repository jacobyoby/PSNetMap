{
  "_comment": "Template: Replace IPs and secret names with your own values",
  "map": {
    "192.168.1.0/24": "YourCredentialName",
    "Default": "ReadOnlyCredential"
  },
  "snmp": {
    "192.168.1.0/24": {
      "version": "v2c",
      "communitySecret": "YourSNMPSecretName"
    },
    "Default": {
      "version": "v2c",
      "communitySecret": "PublicSNMPSecret"
    }
  },
  "_instructions": {
    "setup": "1. Install: Install-Module Microsoft.PowerShell.SecretManagement",
    "store_secret": "2. Store secrets: Set-Secret -Name 'YourSNMPSecretName' -Secret 'your-community-string'",
    "usage": "3. Use: Get-SnmpNeighbors -CredentialMapPath .\\examples\\credmap.json"
  }
}
